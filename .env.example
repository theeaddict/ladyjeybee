# Copy to .env.local (or set in your hosting dashboard) and fill in when the site goes live.

# Live domain, used for canonical URLs, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Meta Pixel ID from Meta Events Manager. Leave empty to turn the pixel off.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Business domain verification code (the content of the facebook-domain-verification meta tag).
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# Google Search Console verification code (the content of the google-site-verification meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
